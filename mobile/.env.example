# Optional. If unset, the app uses the Expo dev server's LAN IP on port 8080,
# then falls back to 10.0.2.2 (Android emulator) / localhost (iOS simulator).
EXPO_PUBLIC_API_URL=http://192.168.1.20:8080/api/v1

# Set true only for the in-memory sample-data demo. Real accounts require false.
EXPO_PUBLIC_DEMO_MODE=false

# Optional production browser portal opened for mobile administrator sessions.
EXPO_PUBLIC_ADMIN_PORTAL_URL=
