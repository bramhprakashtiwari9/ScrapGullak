# Spring Boot backend base URL (all endpoints live under /api/v1)
VITE_API_URL=http://localhost:8080/api/v1

# Optional local demo accounts. Leave unset to use mock sessions.
VITE_DEMO_CUSTOMER_PHONE=
VITE_DEMO_CUSTOMER_PASSWORD=
VITE_DEMO_ADMIN_PHONE=
VITE_DEMO_ADMIN_PASSWORD=

# Set to "hash" when hosting on a static server without SPA rewrites
VITE_ROUTER_MODE=browser
